// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum ContractType {
  VAST
  NUL_UREN
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
}

enum LeaveType {
  VERLOF
  ZIEK
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  UITNODIGING
  DIENST_TOEGEWEZEN
  VERLOF_AANGEVRAAGD
  VERLOF_GOEDGEKEURD
  VERLOF_AFGEWEZEN
  ZIEKMELDING
  ROOSTER_GEPUBLICEERD
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String?
  role                 Role      @default(STAFF)
  isActive             Boolean   @default(true)
  contractHoursPerWeek Float?
  contractType         ContractType?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  invite               Invite?

  shifts               Shift[]              @relation("ShiftAssignee")
  createdShifts        Shift[]              @relation("ShiftCreatedBy")
  leaveRequests        LeaveRequest[]       @relation("LeaveRequester")
  leaveRequestsReviewed LeaveRequest[]      @relation("LeaveReviewer")
  notifications        Notification[]
  permanentShifts        PermanentShift[]   @relation("PermanentShiftAssignee")
  createdPermanentShifts PermanentShift[]   @relation("PermanentShiftCreatedBy")
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
}

model Shift {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  startTime     DateTime
  endTime       DateTime
  breakMinutes  Int         @default(0)
  notes         String?
  status        ShiftStatus @default(DRAFT)

  assignedUserId String?
  assignedUser   User?      @relation("ShiftAssignee", fields: [assignedUserId], references: [id])

  createdById   String
  createdBy     User        @relation("ShiftCreatedBy", fields: [createdById], references: [id])

  permanentShiftId String?
  permanentShift    PermanentShift? @relation(fields: [permanentShiftId], references: [id], onDelete: SetNull)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([date])
  @@index([assignedUserId, date])
}

/// Vast rooster-patroon: op een vaste weekdag ingepland vanaf een bepaalde datum,
/// zonder voorgaande weken met terugwerkende kracht te vullen.
model PermanentShift {
  id           String   @id @default(cuid())

  userId       String
  user         User     @relation("PermanentShiftAssignee", fields: [userId], references: [id], onDelete: Cascade)

  weekday      Int      // 0 = maandag … 6 = zondag (zelfde volgorde als lib/dates.ts)
  startTime    String   // "HH:mm"
  endTime      String   // "HH:mm"
  breakMinutes Int      @default(0)
  notes        String?

  activeFrom   DateTime @db.Date

  createdById  String
  createdBy    User     @relation("PermanentShiftCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  shifts       Shift[]

  @@index([userId, weekday])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)

  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  reason        String?
  status        LeaveStatus @default(PENDING)

  reviewedById  String?
  reviewedBy    User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}
