// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum ContractType {
  VAST
  NUL_UREN
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
}

enum LeaveType {
  VERLOF
  ZIEK
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TodoPriority {
  DRINGEND
  NORMAAL
  NIET_DRINGEND
}

enum NotificationType {
  UITNODIGING
  DIENST_TOEGEWEZEN
  VERLOF_AANGEVRAAGD
  VERLOF_GOEDGEKEURD
  VERLOF_AFGEWEZEN
  ZIEKMELDING
  ROOSTER_GEPUBLICEERD
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String?
  role                 Role      @default(STAFF)
  isActive             Boolean   @default(true)
  contractHoursPerWeek Float?
  contractType         ContractType?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  invite               Invite?

  shifts               Shift[]              @relation("ShiftAssignee")
  createdShifts        Shift[]              @relation("ShiftCreatedBy")
  leaveRequests        LeaveRequest[]       @relation("LeaveRequester")
  leaveRequestsReviewed LeaveRequest[]      @relation("LeaveReviewer")
  notifications        Notification[]
  permanentShifts        PermanentShift[]   @relation("PermanentShiftAssignee")
  createdPermanentShifts PermanentShift[]   @relation("PermanentShiftCreatedBy")
  timeEntries            TimeEntry[]        @relation("TimeEntryOwner")
  reviewedTimeEntries    TimeEntry[]        @relation("TimeEntryReviewer")
  assignedTodos          Todo[]             @relation("TodoAssignee")
  createdTodos           Todo[]             @relation("TodoCreatedBy")
  completedTodos         Todo[]             @relation("TodoCompletedBy")
  permanentTodos          PermanentTodo[]   @relation("PermanentTodoAssignee")
  createdPermanentTodos   PermanentTodo[]   @relation("PermanentTodoCreatedBy")
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
}

model Shift {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  startTime     DateTime
  endTime       DateTime
  breakMinutes  Int         @default(0)
  notes         String?
  status        ShiftStatus @default(DRAFT)

  assignedUserId String?
  assignedUser   User?      @relation("ShiftAssignee", fields: [assignedUserId], references: [id])

  createdById   String
  createdBy     User        @relation("ShiftCreatedBy", fields: [createdById], references: [id])

  permanentShiftId String?
  permanentShift    PermanentShift? @relation(fields: [permanentShiftId], references: [id], onDelete: SetNull)

  /// Gezet wanneer deze dienst automatisch is bijgewerkt via een goedgekeurde inkloktijd.
  correctionMinutes Int?
  correctionNote    String?

  timeEntries   TimeEntry[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([date])
  @@index([assignedUserId, date])
}

/// Vast rooster-patroon: op een vaste weekdag ingepland vanaf een bepaalde datum,
/// zonder voorgaande weken met terugwerkende kracht te vullen.
model PermanentShift {
  id           String   @id @default(cuid())

  userId       String
  user         User     @relation("PermanentShiftAssignee", fields: [userId], references: [id], onDelete: Cascade)

  weekday      Int      // 0 = maandag … 6 = zondag (zelfde volgorde als lib/dates.ts)
  startTime    String   // "HH:mm"
  endTime      String   // "HH:mm"
  breakMinutes Int      @default(0)
  notes        String?

  activeFrom   DateTime @db.Date

  createdById  String
  createdBy    User     @relation("PermanentShiftCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  shifts       Shift[]
  exceptions   PermanentShiftException[]

  @@index([userId, weekday])
}

/// Een specifieke datum die is uitgesloten van een vast patroon (bv. omdat de beheerder
/// die ene dag heeft verwijderd). Voorkomt dat materialisatie 'm opnieuw aanmaakt.
model PermanentShiftException {
  id               String         @id @default(cuid())
  permanentShiftId String
  permanentShift   PermanentShift @relation(fields: [permanentShiftId], references: [id], onDelete: Cascade)
  date             DateTime       @db.Date
  createdAt        DateTime       @default(now())

  @@unique([permanentShiftId, date])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)

  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  startTime     String?     // "HH:mm", optioneel (leeg = hele dag)
  endTime       String?     // "HH:mm", optioneel (leeg = hele dag)
  reason        String?
  status        LeaveStatus @default(PENDING)

  reviewedById  String?
  reviewedBy    User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

enum TimeEntryStatus {
  PENDING
  APPROVED
}

/// Feitelijke in-/uitklokregistratie, los van het geplande rooster. Na het uitklokken
/// kan de medewerker 'm indienen; de beheerder keurt daarna goed (evt. met een
/// correctie in minuten), waarna de bijbehorende Shift automatisch wordt bijgewerkt.
model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("TimeEntryOwner", fields: [userId], references: [id], onDelete: Cascade)

  clockIn   DateTime
  clockOut  DateTime?

  submittedAt       DateTime?
  status            TimeEntryStatus?
  correctionMinutes Int?
  reviewNote        String?
  reviewedById      String?
  reviewedBy        User?            @relation("TimeEntryReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?

  /// De Shift die bij goedkeuring is aangemaakt/bijgewerkt. Wordt de dienst later uit het
  /// rooster verwijderd, dan verdwijnt deze registratie automatisch mee (onDelete: Cascade).
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, clockIn])
  @@index([status])
}

/// Interne to-do voor de beheerder(s), per dag. Geen medewerker (assigneeId = null)
/// betekent "Algemeen". forStaff = true betekent dat de to do hoort bij de
/// medewerkers-lijst (zichtbaar onder Mijn uren > To do bij het personeel).
/// date = null betekent een algemene to do zonder vaste datum.
model Todo {
  id          String       @id @default(cuid())
  title       String
  description String?
  date        DateTime?    @db.Date
  priority    TodoPriority @default(NORMAAL)
  completed   Boolean      @default(false)
  forStaff    Boolean      @default(false)

  /// Alleen relevant voor een algemene (date = null) forStaff-to do: blijft na
  /// afronden bestaan en wordt na 3 dagen automatisch gereset i.p.v. verwijderd.
  permanentGeneral Boolean @default(false)

  assigneeId  String?
  assignee    User?        @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Medewerker die (bij een forStaff-to do) zichzelf als uitvoerder heeft opgegeven.
  completedById String?
  completedBy   User?      @relation("TodoCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  createdById String
  createdBy   User         @relation("TodoCreatedBy", fields: [createdById], references: [id])

  permanentTodoId String?
  permanentTodo   PermanentTodo? @relation(fields: [permanentTodoId], references: [id], onDelete: SetNull)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([date])
  @@index([forStaff, date])
}

/// Vast to-do-patroon: komt vanaf een gekozen datum elke week op dezelfde weekdag
/// terug, zonder voorgaande weken met terugwerkende kracht te vullen. Zelfde opzet
/// als PermanentShift.
model PermanentTodo {
  id          String       @id @default(cuid())
  title       String
  description String?
  weekday     Int          // 0 = maandag … 6 = zondag
  priority    TodoPriority @default(NORMAAL)
  forStaff    Boolean      @default(false)

  assigneeId  String?
  assignee    User?        @relation("PermanentTodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  activeFrom  DateTime     @db.Date

  createdById String
  createdBy   User         @relation("PermanentTodoCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  todos       Todo[]
  exceptions  PermanentTodoException[]

  @@index([assigneeId, weekday])
}

/// Een specifieke datum die is uitgesloten van een vast to-do-patroon (bv. omdat de
/// beheerder die ene dag heeft verwijderd).
model PermanentTodoException {
  id              String        @id @default(cuid())
  permanentTodoId String
  permanentTodo   PermanentTodo @relation(fields: [permanentTodoId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  createdAt       DateTime      @default(now())

  @@unique([permanentTodoId, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// ============================================================================
// STYLRS — losstaand SaaS-boekingsplatform voor kapsalons/barbershops.
// Volledig gescheiden van de Werkwijzer-modellen hierboven (los inlogsysteem,
// eigen entiteiten). Elke tabel hangt aan salonId zodat scheiding tussen
// salons (multi-tenancy) ook op databaseniveau is afgedwongen.
// ============================================================================

enum SalonUserRole {
  OWNER
  STAFF
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  MANUAL
  ONLINE
}

model Salon {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique

  email       String?
  phone       String?
  address     String?
  postalCode  String?
  city        String?
  website     String?
  logoUrl     String?
  timezone    String   @default("Europe/Amsterdam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           SalonUser[]
  employees       Employee[]
  services        Service[]
  customers       Customer[]
  appointments    Appointment[]
  openingHours    OpeningHours[]
  bookingSettings BookingSettings?
  emailSettings   EmailAutomationSettings?
}

/// Login-account voor een salon. OWNER heeft volledige toegang, STAFF beperkt
/// (eigen agenda/afspraken). Een STAFF-account kan gekoppeld zijn aan een
/// Employee-profiel voor "eigen agenda"; dit is optioneel voor OWNER.
model SalonUser {
  id           String        @id @default(cuid())
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  name         String
  email        String        @unique
  passwordHash String
  role         SalonUserRole @default(OWNER)
  isActive     Boolean       @default(true)

  employeeId   String?       @unique
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([salonId])
}

model Employee {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  photoUrl  String?
  email     String?
  phone     String?
  function  String?
  /// Hexcode (bv. #7C5CFC) voor herkenbare kleur in de agenda.
  color     String   @default("#7C5CFC")
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loginAccount SalonUser?
  availability EmployeeAvailability[]
  timeOff      TimeOff[]
  services     EmployeeService[]
  appointments Appointment[]

  @@index([salonId])
}

/// Werktijden van een medewerker per weekdag. 0 = maandag … 6 = zondag.
/// Geen rij voor een weekdag betekent: die dag werkt de medewerker niet.
model EmployeeAvailability {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  weekday        Int
  startTime      String
  endTime        String
  breakStartTime String?
  breakEndTime   String?

  @@unique([employeeId, weekday])
}

/// Vrije dag(en) / vakantie van een medewerker.
model TimeOff {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?

  createdAt DateTime @default(now())

  @@index([employeeId, startDate, endDate])
}

model Service {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  category        String?
  active          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees    EmployeeService[]
  appointments Appointment[]

  @@index([salonId])
}

model EmployeeService {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
}

model Customer {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String?
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  notes        CustomerNote[]

  @@index([salonId])
  @@index([salonId, email])
  @@index([salonId, phone])
}

/// Interne notitie van een medewerker bij een klant. Uitsluitend zichtbaar
/// binnen de salon.
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  @@index([customerId])
}

model Appointment {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime
  /// Prijs op het moment van boeken (blijft ongewijzigd als de behandelprijs later wijzigt).
  price     Decimal            @db.Decimal(10, 2)
  status    AppointmentStatus  @default(CONFIRMED)
  source    AppointmentSource  @default(MANUAL)
  note      String?

  confirmationSentAt DateTime?
  reminderSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId, startTime])
  @@index([employeeId, startTime])
  @@index([status])
}

/// Openingstijden van de salon per weekdag. 0 = maandag … 6 = zondag.
/// isClosed = true betekent gesloten die dag.
model OpeningHours {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  weekday   Int
  isClosed  Boolean @default(false)
  openTime  String?
  closeTime String?

  @@unique([salonId, weekday])
}

model BookingSettings {
  id      String @id @default(cuid())
  salonId String @unique
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  /// Hoeveel dagen vooruit een klant mag boeken.
  maxAdvanceDays        Int     @default(60)
  /// Hoe kort van tevoren nog geboekt mag worden.
  minNoticeMinutes      Int     @default(120)
  /// Minimale tijd tussen afspraken (buffer).
  bufferMinutes         Int     @default(0)
  allowEmployeeSelection Boolean @default(true)
  allowNoPreference      Boolean @default(true)
  allowCustomerCancel    Boolean @default(true)
  cancelDeadlineHours    Int     @default(24)
  requirePhone           Boolean @default(true)
  requireEmail           Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model EmailAutomationSettings {
  id      String @id @default(cuid())
  salonId String @unique
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  confirmationEnabled Boolean @default(true)
  reminderEnabled     Boolean @default(true)
  reminderHoursBefore Int     @default(24)
  rescheduledEnabled  Boolean @default(true)
  cancelledEnabled    Boolean @default(true)
  reviewRequestEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
}
